#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/mnt/d/DarkBytez/PosturePlus/node_modules/.pnpm/turbo@2.8.12/node_modules/turbo/node_modules:/mnt/d/DarkBytez/PosturePlus/node_modules/.pnpm/turbo@2.8.12/node_modules:/mnt/d/DarkBytez/PosturePlus/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/mnt/d/DarkBytez/PosturePlus/node_modules/.pnpm/turbo@2.8.12/node_modules/turbo/node_modules:/mnt/d/DarkBytez/PosturePlus/node_modules/.pnpm/turbo@2.8.12/node_modules:/mnt/d/DarkBytez/PosturePlus/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../turbo/bin/turbo" "$@"
else
  exec node  "$basedir/../turbo/bin/turbo" "$@"
fi
